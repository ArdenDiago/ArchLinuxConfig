// Minimal niri config installed by modules/16-niri.sh.
// Full reference: https://niri-wm.github.io/niri/Configuration:-Introduction

// Env vars for every process niri spawns (terminals, fuzzel launches,
// autostart apps). Firefox specifically needs these two to behave under
// niri instead of falling back to blurry, portal-less XWayland:
//   MOZ_ENABLE_WAYLAND — draw natively on Wayland instead of through
//     XWayland (fixes blurry/incorrect scaling on HiDPI or fractional
//     scale, and is required for direct Wayland screen capture).
//   GTK_USE_PORTAL — route GTK dialogs (Firefox's file picker included)
//     through xdg-desktop-portal instead of GTK's own Wayland-broken
//     native chooser. Paired with modules/16-niri.sh installing the
//     portal backends and niri-portals.conf below.
environment {
    MOZ_ENABLE_WAYLAND "1"
    GTK_USE_PORTAL "1"

    // NVIDIA's hardware cursor plane goes out of sync with the compositor's
    // own cursor rendering on this GPU, producing a visible duplicate/ghost
    // cursor. Forcing software-only cursor rendering fixes it.
    WLR_NO_HARDWARE_CURSORS "1"
}

// HDMI-A-1 on the left, laptop panel (eDP-1) on the right — eDP-1's position
// starts at HDMI-A-1's width (1920) so the two sit flush with no overlap/gap.
// Refresh rate is left unspecified so niri picks each output's highest mode
// automatically (run `niri msg outputs` to confirm the exact numbers).
output "HDMI-A-1" {
    mode "1920x1080"
    scale 1.0
    position x=0 y=0
}

output "eDP-1" {
    mode "1920x1080"
    scale 1.25
    position x=1920 y=0
}

input {
    keyboard {
        xkb {}
    }
    touchpad {
        tap
        natural-scroll
    }
}

layout {
    gaps 8
    center-focused-column "never"
    default-column-width { proportion 0.5; }
}

spawn-at-startup "mako"
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
spawn-sh-at-startup "~/.config/wallpaper/restore.sh"

binds {
    Mod+Return hotkey-overlay-title="Open a Terminal: alacritty" { spawn "alacritty"; }
    Mod+D hotkey-overlay-title="Run an Application: fuzzel" { spawn "fuzzel"; }
    // Deferred per docs/01-lockscreen.md: stays on hyprlock until a
    // logind-Lock-signal listener launches desktopdesigner-lock. Keep
    // hyprlock installed as fallback until that listener exists.
    Mod+Alt+L hotkey-overlay-title="Lock the Screen: hyprlock" { spawn "hyprlock"; }
    Mod+W hotkey-overlay-title="Pick a Wallpaper" { spawn "qs" "-c" "desktopdesigner" "ipc" "call" "wallpaperPicker" "toggle"; }

    // desktopdesigner overlays, via its IPC — see KEYBINDINGS.md and
    // desktopdesigner/shell.qml's IpcHandler targets (qs run --session
    // must already be live for these to have something to reach).
    Mod+Space hotkey-overlay-title="Spotlight Launcher" { spawn "qs" "-c" "desktopdesigner" "ipc" "call" "spotlight" "toggle"; }
    // wlogout — standalone GTK layer-shell power menu, no DMS dependency.
    Mod+X hotkey-overlay-title="Power Menu" { spawn "wlogout"; }
    // mako owns notifications (no DMS "notification center" list UI to
    // replace) — restores the last dismissed popup as the closest
    // equivalent. Repoint to desktopdesigner's notificationCenter once
    // that IPC target ships (docs/02-bar.md: currently a static stub).
    Mod+N hotkey-overlay-title="Restore Last Notification" { spawn "makoctl" "restore"; }
    // Mod+V is already toggle-window-floating below, so clipboard gets
    // Mod+Shift+V instead of the Mod+V DMS itself suggests.
    // cliphist + fuzzel's dmenu mode — standard wlroots-ecosystem clipboard
    // manager pattern, needs a shell for the pipeline.
    Mod+Shift+V hotkey-overlay-title="Clipboard Manager" { spawn-sh "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy"; }
    Mod+M hotkey-overlay-title="Task Manager: btop" { spawn "alacritty" "-e" "btop"; }
    Mod+Shift+N hotkey-overlay-title="Notepad" { spawn "qs" "-c" "desktopdesigner" "ipc" "call" "quickNotes" "toggle"; }
    // Mod+Comma (DMS settings panel) and Mod+Y (DMS's own wallpaper
    // browser) dropped outright — no non-DMS equivalent exists yet and
    // Mod+W (desktopdesigner wallpaperPicker) already covers wallpapers.
    // Independent of desktopdesigner — Rust/Ratatui popup, see
    // docs/06-terminal-clock.md and terminal-clock/popup.sh.
    Mod+T hotkey-overlay-title="Terminal Clock" { spawn-sh "~/Coding/ArchLinuxNewConfig/terminal-clock/popup.sh"; }

    Mod+Q repeat=false { close-window; }

    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }

    // vim-style equivalents of the arrow binds above.
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+K { focus-window-up; }
    Mod+J { focus-window-down; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Down  { move-window-down; }

    // vim-style equivalents of the arrow binds above. H/L can't go on
    // Mod+Ctrl (already focus-monitor-left/right) or Mod+Alt (Alt+L is
    // lock-screen), so move-column-left/right land on Mod+Alt+Shift instead.
    Mod+Ctrl+K      { move-window-up; }
    Mod+Ctrl+J      { move-window-down; }
    Mod+Alt+Shift+H { move-column-left; }
    Mod+Alt+Shift+L { move-column-right; }

    // Monitor-to-monitor (you run HDMI-A-1 + eDP-1 side by side). DMS
    // suggests Mod+Ctrl+Left/Right for this, but that's already move-column
    // above, so this uses vim h/l instead — only left/right since the two
    // outputs are side by side, no up/down monitor to focus-monitor-up/down.
    Mod+Ctrl+H { focus-monitor-left; }
    Mod+Ctrl+L { focus-monitor-right; }
    Mod+Ctrl+Shift+H { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+L { move-column-to-monitor-right; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // Workspace up/down, keeping the U/I-flank-the-home-row convention:
    // Mod+U/I focuses, Mod+Ctrl+U/I moves the column — same Ctrl-means-move
    // pattern as the Left/Right workspace and monitor binds above.
    Mod+I { focus-workspace-up; }
    Mod+U { focus-workspace-down; }
    Mod+Ctrl+I { move-column-to-workspace-up; }
    Mod+Ctrl+U { move-column-to-workspace-down; }

    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+V { toggle-window-floating; }
    // Switches keyboard focus between the floating and tiling stacks,
    // distinct from Mod+V above (which toggles one window's floating state).
    Mod+Grave { switch-focus-between-floating-and-tiling; }
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // Resize the focused column/window, vim-style — same h/j/k/l-for-resize
    // convention as the tmux pane bindings. niri sizes by percentage of the
    // output rather than a fixed pixel step. No literal "direction" concept
    // here (unlike tmux panes), so h/l = width narrower/wider, j/k = height
    // shorter/taller.
    Mod+Shift+H { set-column-width "-10%"; }
    Mod+Shift+L { set-column-width "+10%"; }
    Mod+Shift+J { set-window-height "-10%"; }
    Mod+Shift+K { set-window-height "+10%"; }
    // Cycles the focused column through niri's preset widths (1/3, 1/2, 2/3
    // of the output by default) instead of the ∓10% nudging above.
    Mod+R { switch-preset-column-width; }

    // Screenshots: plain = interactive area select, Ctrl = full monitor,
    // Alt = focused window only. Saved to screenshot-path (niri default) /
    // copied to clipboard depending on niri's screenshot UI.
    Print      { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }

    // Media keys — wpctl (wireplumber, already the PipeWire session
    // manager)/brightnessctl/playerctl directly. No DMS dependency: these
    // work whether or not any shell process is even running.
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1.0" "@DEFAULT_AUDIO_SINK@" "3%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "3%-"; }
    XF86AudioMute        allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }

    XF86AudioPlay  allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPrev  allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioNext  allow-when-locked=true { spawn "playerctl" "next"; }

    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }

    // Overview of every window/workspace on the current monitor — the same
    // thing the top-left hot corner already triggers, just on a key too.
    Mod+Tab repeat=false hotkey-overlay-title="Overview" { toggle-overview; }

    Mod+Shift+E { quit; }
    Mod+Shift+Slash { show-hotkey-overlay; }
}
