binds {
    Mod+Return hotkey-overlay-title="Open a Terminal: alacritty" { spawn "alacritty"; }
    Mod+D hotkey-overlay-title="Run an Application: fuzzel" { spawn "fuzzel"; }
    Mod+Alt+L hotkey-overlay-title="Lock the Screen: hyprlock" { spawn "hyprlock"; }
    // skwd-wall, not noctalia's own wallpaper panel — see
    // modules/26-wallpaper-skwd.sh. displayMode is a persistent config.json
    // field, not a per-call arg, so each bind flips it before toggling.
    Mod+W hotkey-overlay-title="Pick a Wallpaper" { spawn-sh "jq '.components.wallpaperSelector.displayMode = \"slices\"' ~/.config/skwd-wall/config.json > /tmp/skwd-cfg.tmp && mv /tmp/skwd-cfg.tmp ~/.config/skwd-wall/config.json && skwd wall toggle"; }
    Mod+Shift+W hotkey-overlay-title="Pick a Wallpaper (Grid)" { spawn-sh "jq '.components.wallpaperSelector.displayMode = \"wall\"' ~/.config/skwd-wall/config.json > /tmp/skwd-cfg.tmp && mv /tmp/skwd-cfg.tmp ~/.config/skwd-wall/config.json && skwd wall toggle"; }

    // Noctalia shell features, via its `msg` IPC (noctalia --daemon is
    // already running persistently).
    Mod+Space hotkey-overlay-title="App Launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+X hotkey-overlay-title="Power Menu" { spawn "noctalia" "msg" "panel-toggle" "session"; }
    // Noctalia has no standalone notification-center panel — notifications
    // live inside control-center alongside quick settings.
    Mod+N hotkey-overlay-title="Control Center" { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    // Mod+V is already toggle-window-floating below, so clipboard gets
    // Mod+Shift+V instead.
    Mod+Shift+V hotkey-overlay-title="Clipboard Manager" { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
    // Wifi/Bluetooth: keyboard-driven TUIs (impala talks to iwd, bluetuith
    // is a TUI bluetooth manager) in a floating terminal instead of
    // noctalia's mouse-driven Control Center tabs — see
    // launch-wifi-tui.sh / launch-bluetooth-tui.sh (installed by
    // modules/16-niri.sh) for why they poll for the window id and hide
    // it via opacity until floated/sized/centered.
    Mod+Shift+N hotkey-overlay-title="Wifi (impala)" { spawn-sh "~/.config/niri/launch-wifi-tui.sh"; }
    Mod+B hotkey-overlay-title="Bluetooth (bluetuith)" { spawn-sh "~/.config/niri/launch-bluetooth-tui.sh"; }
    // Direct shortcut into Control Center's system tab (same floating,
    // centered panel as Mod+N, just opened straight to that tab).
    Mod+M hotkey-overlay-title="System Resources" { spawn "noctalia" "msg" "panel-toggle" "control-center" "system"; }
    Mod+Comma hotkey-overlay-title="Settings" { spawn "noctalia" "msg" "settings-toggle"; }

    Mod+Q repeat=false { close-window; }

    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }

    // vim-style equivalents of the arrow binds above.
    Mod+H { focus-column-left; }
    Mod+L { focus-column-right; }
    Mod+K { focus-window-up; }
    Mod+J { focus-window-down; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Down  { move-window-down; }

    // vim-style equivalents of the arrow binds above. H/L can't go on
    // Mod+Ctrl (already focus-monitor-left/right) or Mod+Alt (Alt+L is
    // lock-screen), so move-column-left/right land on Mod+Alt+Shift instead.
    Mod+Ctrl+K      { move-window-up; }
    Mod+Ctrl+J      { move-window-down; }
    Mod+Alt+Shift+H { move-column-left; }
    Mod+Alt+Shift+L { move-column-right; }

    // Monitor-to-monitor (dual-monitor desktop: HDMI-A-1 + eDP-1 side by
    // side). Uses vim h/l — only left/right since the two outputs are side
    // by side, no up/down monitor to focus-monitor-up/down. Harmless no-op
    // on a single-monitor machine.
    Mod+Ctrl+H { focus-monitor-left; }
    Mod+Ctrl+L { focus-monitor-right; }
    Mod+Ctrl+Shift+H { move-column-to-monitor-left; }
    Mod+Ctrl+Shift+L { move-column-to-monitor-right; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Ctrl+1 { move-column-to-workspace 1; }
    Mod+Ctrl+2 { move-column-to-workspace 2; }
    Mod+Ctrl+3 { move-column-to-workspace 3; }
    Mod+Ctrl+4 { move-column-to-workspace 4; }
    Mod+Ctrl+5 { move-column-to-workspace 5; }
    Mod+Ctrl+6 { move-column-to-workspace 6; }
    Mod+Ctrl+7 { move-column-to-workspace 7; }
    Mod+Ctrl+8 { move-column-to-workspace 8; }
    Mod+Ctrl+9 { move-column-to-workspace 9; }

    // Workspace up/down, keeping the U/I-flank-the-home-row convention:
    // Mod+U/I focuses, Mod+Ctrl+U/I moves the column — same Ctrl-means-move
    // pattern as the Left/Right workspace and monitor binds above.
    Mod+I { focus-workspace-up; }
    Mod+U { focus-workspace-down; }
    Mod+Ctrl+I { move-column-to-workspace-up; }
    Mod+Ctrl+U { move-column-to-workspace-down; }

    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+V { toggle-window-floating; }
    // Switches keyboard focus between the floating and tiling stacks,
    // distinct from Mod+V above (which toggles one window's floating state).
    Mod+Grave { switch-focus-between-floating-and-tiling; }
    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }

    // Resize the focused column/window, vim-style — same h/j/k/l-for-resize
    // convention as tmux pane bindings. niri sizes by percentage of the
    // output rather than a fixed pixel step. h/l = width narrower/wider,
    // j/k = height shorter/taller.
    Mod+Shift+H { set-column-width "-10%"; }
    Mod+Shift+L { set-column-width "+10%"; }
    Mod+Shift+J { set-window-height "-10%"; }
    Mod+Shift+K { set-window-height "+10%"; }
    // Cycles the focused column through niri's preset widths (1/3, 1/2, 2/3
    // of the output by default) instead of the ∓10% nudging above.
    Mod+R { switch-preset-column-width; }

    // Screenshots: plain = interactive area select, Ctrl = full monitor,
    // Alt = focused window only.
    Print      { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }

    // Media keys — routed through noctalia's backend (noctalia --daemon is
    // already running persistently, so these IPC calls have something to
    // reach) rather than wpctl/brightnessctl directly, so volume/brightness
    // stay in sync with whatever noctalia's own UI shows.
    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up" "3"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down" "3"; }
    XF86AudioMute        allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "noctalia" "msg" "mic-mute"; }

    XF86AudioPlay  allow-when-locked=true { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AudioPause allow-when-locked=true { spawn "noctalia" "msg" "media" "toggle"; }
    XF86AudioPrev  allow-when-locked=true { spawn "noctalia" "msg" "media" "previous"; }
    XF86AudioNext  allow-when-locked=true { spawn "noctalia" "msg" "media" "next"; }

    XF86MonBrightnessUp   allow-when-locked=true { spawn "sh" "-c" "exec \"$HOME/.config/niri/brightness-step.sh\" up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "sh" "-c" "exec \"$HOME/.config/niri/brightness-step.sh\" down"; }

    // Overview of every window/workspace on the current monitor.
    Mod+Tab repeat=false hotkey-overlay-title="Overview" { toggle-overview; }

    // Independent of noctalia/desktopdesigner — Rust/Ratatui fullscreen
    // popup, see docs/terminal-clock.md and terminal-clock/popup.sh.
    Mod+T hotkey-overlay-title="Terminal Clock" { spawn-sh "~/Coding/ArchLinuxNewConfig/terminal-clock/popup.sh"; }

    Mod+Shift+E { quit; }
    Mod+Shift+Slash { show-hotkey-overlay; }
}
