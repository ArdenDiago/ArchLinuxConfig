// Scratch niri config for the isolated NiriFullSetup/noctalia test
// container only — sibling to test-config.kdl (desktopdesigner). NOT a
// copy of NiriFullSetup/niri/config.kdl: drops the two hardcoded
// HDMI-A-1/eDP-1 output blocks (nested/winit mode makes its own virtual
// output, and neither connector exists in here anyway — same reasoning
// as the real config's own comment) and drops `include "noctalia.kdl"`
// (that file is generated by `noctalia msg templates-apply` against a
// live daemon; it doesn't exist until after first boot, and `include`
// of a missing file is fatal, unlike an output block for a connector
// that doesn't exist).

environment {
    MOZ_ENABLE_WAYLAND "1"
    GTK_USE_PORTAL "1"
    WLR_NO_HARDWARE_CURSORS "1"
}

input {
    keyboard {
        xkb {}
    }
}

layout {
    gaps 8
}

hotkey-overlay {
    skip-at-startup
}

spawn-at-startup "mako"
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
spawn-at-startup "kwalletd6"
spawn-at-startup "noctalia" "--daemon"

binds {
    Mod+Return hotkey-overlay-title="Terminal: alacritty" { spawn "alacritty"; }
    Mod+Q repeat=false { close-window; }
    Mod+Shift+E { quit; }
    Mod+Shift+Slash { show-hotkey-overlay; }
}
