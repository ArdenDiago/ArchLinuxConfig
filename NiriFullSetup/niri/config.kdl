// niri + noctalia setup, as configured in the live 2026-08-28 session that
// replaced DankMaterialShell with noctalia. Keybinds live in binds.kdl
// (included below). Installed to ~/.config/niri/config.kdl by setup/setup.sh.

// Env vars for every process niri spawns (terminals, launcher, autostart
// apps). Firefox specifically needs these two to behave under niri instead
// of falling back to blurry, portal-less XWayland:
//   MOZ_ENABLE_WAYLAND — draw natively on Wayland instead of through
//     XWayland (fixes blurry/incorrect scaling on HiDPI or fractional
//     scale, and is required for direct Wayland screen capture).
//   GTK_USE_PORTAL — route GTK dialogs (Firefox's file picker included)
//     through xdg-desktop-portal instead of GTK's own Wayland-broken
//     native chooser.
environment {
    MOZ_ENABLE_WAYLAND "1"
    GTK_USE_PORTAL "1"

    // NVIDIA's hardware cursor plane goes out of sync with the compositor's
    // own cursor rendering on this GPU, producing a visible duplicate/ghost
    // cursor. Forcing software-only cursor rendering fixes it. Harmless on
    // non-NVIDIA machines.
    WLR_NO_HARDWARE_CURSORS "1"
}

// Tuned for the dual-monitor desktop this was built on: HDMI-A-1 on the
// left, laptop panel (eDP-1) on the right, eDP-1's position starting at
// HDMI-A-1's width (1920) so the two sit flush with no overlap/gap. niri
// ignores output blocks for connectors that don't exist, so this is safe
// to leave as-is on a single-display VM/laptop — it just won't match
// anything and niri falls back to its own defaults. Run `niri msg outputs`
// on the target machine and adjust connector names/scale if needed.
output "HDMI-A-1" {
    mode "1920x1080"
    scale 1.0
    position x=0 y=0
}

output "eDP-1" {
    mode "1920x1080"
    scale 1.25
    position x=1920 y=0
}

input {
    keyboard {
        xkb {}
    }
    touchpad {
        tap
        natural-scroll
    }
}

layout {
    gaps 8
    center-focused-column "never"
    default-column-width { proportion 0.5; }
}

cursor {
    xcursor-theme "default"
    xcursor-size 24
    hide-when-typing
}

spawn-at-startup "mako"
spawn-at-startup "/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1"
spawn-at-startup "kwalletd6"
spawn-at-startup "noctalia" "--daemon"

include "binds.kdl"

// Overview backdrop — the area outside window/workspace content when
// Mod+Tab is open. backdrop-color is kept in sync with noctalia's palette
// by ~/.config/niri/sync-overview-color.sh, run on noctalia's
// hooks.colors_changed event (see noctalia/settings.toml) — do not hand-edit
// the hex here, it gets overwritten. workspace-shadow is a static visual
// touch (drop shadow under each workspace thumbnail), not theme-synced.
overview {
    backdrop-color "#0b0e14"
    workspace-shadow {
        softness 30
        spread 5
        offset x=0 y=10
        color "#00000070"
    }
}

// Deliberately NOT using a window-rule to float the CPU/RAM/GPU/network
// bar-click btop terminal (app-id="floating-btop"): niri doesn't reliably
// match app-id at window-map time (niri-wm/niri#3420), so a window-rule
// here silently does nothing. scripts/launch-btop-float.sh floats/sizes/
// centers that window explicitly via `niri msg action` instead — see that
// script's own comment for the full explanation.

// Generated by noctalia's "niri" template (theme.templates.builtin_ids in
// noctalia/settings.toml) — regenerates on every palette change via
// `noctalia msg templates-apply` or a wallpaper change. Don't hand-edit;
// setup.sh runs templates-apply once so this exists on first boot.
include "noctalia.kdl"
